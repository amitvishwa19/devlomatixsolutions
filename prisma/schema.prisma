generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  SUPERADMIN
  SERVICE
  GUEST
}

model User {
  id                        String              @id @default(cuid())
  uuid                      String?
  displayName               String?
  username                  String?             @unique
  email                     String?             @unique
  phone                     String?             @unique
  avatar                    String?
  isVerified                Boolean             @default(false)
  isActive                  Boolean             @default(false)
  password                  String?
  uid                       String?
  provider                  String?
  role                      ROLE                @default(GUEST)
  webDeviceToken            String?
  deviceToken               String?
  expoPushToken             String?
  refreshToken              String?
  accessToken               String?
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  lastActive                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  campaigns                 Campaign[]
  contacts                  Contact[]
  credit                    Credit?
  profile                   Profile?
  servers                   Server[]
  setting                   Setting?
  roles                     Role[]              @relation("RoleToUser")
  botFlows                  BotFlow[]
  whatsAppAuths             WhatsAppAuth[]
  messageTemplates          MessageTemplate[]
  waMessages                WhatsAppMessage[]
  contactGroups             ContactGroup[]
  workspaceDocuments        WorkspaceDocument[]
  sharedDocuments           DocumentAccess[]    @relation("UserToDocumentAccess")
  credentials               Credentials[]
  assignedTasks             KanbanTask[]        @relation("TaskAssignee")
  kanbanActivities          KanbanActivity[]
  members                   Member[]
  channels                  Channel[]
  jobs                      Job[]
  atsNotes                  AtsNote[]
  scorecards                Scorecard[]

  @@index([email])
  @@index([phone])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  general       Json?
  hospitalInfo  Json?
  locale        Json?
  social        Json?
  technical     Json?
  appointments  Json?
  consultation  Json?
  billing       Json?
  departments   Json?
  integrations  Json?
  inventory     Json?
  invoice       Json?
  notifications Json?
  patients      Json?
  pharmacy      Json?
  prescription  Json?
  security      Json?
  services      Json?
  staff         Json?
  privacy       String?
  terms         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Server {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     Member[]
  channels    Channel[]

  @@index([userId])
}

enum ChannelType {
  TEXT
  AUDIO
  VIDEO
}

model Channel {
  id   String      @id @default(cuid())
  name String
  type ChannelType @default(TEXT)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([serverId])
}

enum MemberRole {
  DOCTOR
  PATIENT
  ADMIN
  STAFF
}

model Member {
  id   String     @id @default(cuid())
  role MemberRole @default(PATIENT)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  messages       Message[]
  directMessages DirectMessage[]

  conversationsInitiated Conversation[] @relation("MemberOne")
  conversationsReceived  Conversation[] @relation("MemberTwo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([serverId])
}

model Message {
  id      String @id @default(cuid())
  content String @db.Text

  fileUrl String? @db.Text

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  deleted    Boolean @default(false)
  sent       Boolean @default(false)
  deleivered Boolean @default(false)
  read       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@index([memberId])
}

model Conversation {
  id String @id @default(cuid())

  memberOneId String
  memberOne   Member @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: Cascade)

  memberTwoId String
  memberTwo   Member @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: Cascade)

  directMessages DirectMessage[]

  @@unique([memberOneId, memberTwoId])
  @@index([memberTwoId])
}

model DirectMessage {
  id      String  @id @default(cuid())
  content String  @db.Text
  fileUrl String? @db.Text

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  deleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([conversationId])
}

model Role {
  id          String       @id @default(cuid())
  title       String       @unique
  description String?
  color       String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")
}

model Permission {
  id          String   @id @default(cuid())
  title       String
  value       String   @unique
  color       String?  @default("#FFFF")
  description String
  category    String?
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String?
  action      String?
  entityId    String?
  entityType  String?
  entityTitle String?
  userId      String?
  userImage   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique
  type      String   @default("virtual")
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String              @id @default(cuid())
  name            String
  description     String?
  status          String              @default("DRAFT")
  messageType     String              @default("text")
  messageTemplate Json
  templateId      String?
  template        MessageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime?
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]

  @@index([templateId])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  phone      String
  status     String    @default("PENDING")
  errorLog   String?
  variables  Json?
  sentAt     DateTime?
  campaignId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model WhatsAppAuth {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // Connection Status
  status WA_STATUS @default(DISCONNECTED)

  // Session Management
  sessionId   String // Unique per user
  sessionName String? // User-friendly name like "My Phone"

  // Device Info (populated after successful connection)
  deviceId    String? // WhatsApp device ID
  phoneNumber String? // Connected phone number
  deviceName  String? // Device name (e.g., "iPhone 14 Pro")
  platform    String? // ios/android/web

  // QR Code (temporary, cleared after connection)
  qrCode      String?
  qrExpiresAt DateTime?

  // Auth Data (critical credentials)
  credentials Json? // Baileys credentials (creds, keys)

  // Timestamps
  connectedAt     DateTime?
  lastConnectedAt DateTime?
  disconnectedAt  DateTime?
  expiresAt       DateTime? // When session expires

  // Metadata
  isActive Boolean @default(true)
  metadata Json? // Additional info (IP, location, etc.)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Connection logs
  logs WhatsAppConnectionLog[]
  keys WhatsAppSessionKey[]

  @@unique([sessionId])
  @@index([userId])
  @@index([phoneNumber])
}

model MessageTemplate {
  id       String  @id @default(cuid())
  userId   String
  name     String
  category String  @default("UTILITY")
  language String  @default("en_US")
  type     String  @default("TEXT")
  body     String  @db.Text
  footer   String?
  buttons  Json? // Array of strings
  metadata Json? // Stores mediaUrl, locationLat, locationLong, etc.
  status   String  @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]

  @@unique([userId, name])
  @@index([userId])
}

model WhatsAppMessage {
  id        String  @id @default(cuid())
  waId      String? @unique // The WhatsApp Message ID (msg.key.id)
  userId    String
  jid       String // Remote phone number
  text      String  @db.Text
  fromMe    Boolean
  timestamp BigInt
  status    String  @default("SENT") // SENT, DELIVERED, READ
  metadata  Json? // For media URLs, etc.

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([jid])
  @@index([createdAt])
}

model WhatsAppConnectionLog {
  id             String        @id @default(cuid())
  whatsappAuthId String?
  whatsappAuth   WhatsAppAuth? @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)
  event          String // CONNECT, DISCONNECT, QR_SCAN, ERROR
  previousStatus String?
  newStatus      String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([whatsappAuthId])
  @@index([createdAt])
}

enum WA_STATUS {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  AUTHENTICATED
  CONNECTED
  LOGGED_OUT
  ERROR
}

model Contact {
  id              String         @id @default(cuid())
  userId          String
  name            String
  phone           String         @unique
  email           String?
  info            Json?
  tags            String[]       @default([])
  lastMessage     String?
  lastInteraction DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups          ContactGroup[] @relation("ContactToGroup")

  @@index([userId])
  @@index([phone])
}

model BotFlow {
  id          String        @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps       BotFlowStep[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model BotFlowStep {
  id        String   @id @default(cuid())
  botFlowId String
  botFlow   BotFlow  @relation(fields: [botFlowId], references: [id], onDelete: Cascade)
  type      String // e.g., 'message', 'condition', 'action'
  config    Json // configuration for the step
  positionX Int // for drag and drop UI
  positionY Int
  order     Int // order in the flow
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botFlowId])
}

model WhatsAppSessionKey {
  id             String       @id @default(cuid())
  whatsappAuth   WhatsAppAuth @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)
  whatsappAuthId String
  keyId          String
  data           String

  @@unique([whatsappAuthId, keyId])
  @@index([whatsappAuthId])
}

model ContactGroup {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  contacts    Contact[] @relation("ContactToGroup")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model WorkspaceDocument {
  id          String              @id @default(cuid())
  name        String
  description String?
  fileUrl     String?
  fileKey     String?
  fileType    String?
  extension   String?
  fileSize    Int?
  category    String?             @default("GENERAL")
  isFolder    Boolean             @default(false)
  parentId    String?
  parent      WorkspaceDocument?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    WorkspaceDocument[] @relation("FolderHierarchy")
  workspaceId String
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWith  DocumentAccess[]
  members     String[]            @default([])
  isStarred   Boolean             @default(false)
  status      String              @default("APPROVED") // PENDING, REVIEW, APPROVED
  tags        String[]            @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@index([workspaceId])
  @@index([userId])
  @@index([parentId])
}

model DocumentAccess {
  id         String            @id @default(cuid())
  documentId String
  userId     String
  document   WorkspaceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation("UserToDocumentAccess", fields: [userId], references: [id], onDelete: Cascade)
  role       String            @default("VIEWER") // VIEWER, EDITOR
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String
  description String?
  color       String?    @default("#3b82f6")
  type        String     @default("GENERAL") // e.g., ARTICLE, DOCUMENT, etc.
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  workspaceId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       Post[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([parentId])
}

model Credentials {
  id          String  @id @default(cuid())
  platform    String // FACEBOOK, LINKEDIN, TWITTER, INSTAGRAM
  profile     String?
  credentials Json?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expired   Boolean  @default(false)
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Post {
  id          String     @id @default(cuid())
  title       String?
  content     String     @db.Text
  mediaUrls   String[]   @default([])
  scheduledAt DateTime?
  publishedAt DateTime?
  status      PostStatus @default(DRAFT)
  errorLog    String?    @db.Text

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags String[] @default([])

  workspaceId String
  userId      String

  // Platform-specific IDs for analytics
  externalIds Json?

  // Platforms this post is destined for
  platforms String[] // Array of platform names

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model SystemLog {
  id          String   @id @default(cuid())
  workspaceId String?
  level       String // INFO, WARNING, ERROR, SUCCESS
  type        String // CRON, TRIGGER, AI, SYSTEM, AUTH, WEBHOOK
  message     String   @db.Text
  details     Json? // For error stacks or extra data
  userId      String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([level])
  @@index([createdAt])
}

// --- Productivity: Unified Kanban Board ---

model KanbanColumn {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  workspaceId String
  tasks       KanbanTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model KanbanTask {
  id       String    @id @default(cuid())
  title    String
  type     String    @default("task") // article, social, note, etc.
  content  String?   @db.Text
  priority String    @default("medium") // low, medium, high, urgent
  dueDate  DateTime?
  order    Int       @default(0)

  columnId String
  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  workspaceId String
  userId      String
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?

  coverUrl String?

  checklists KanbanChecklist[]
  activities KanbanActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
  @@index([workspaceId])
  @@index([userId])
  @@index([assigneeId])
}

model KanbanChecklist {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)

  taskId String
  task   KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model KanbanActivity {
  id          String @id @default(cuid())
  type        String // CREATE, MOVE, UPDATE, DELETE, CHECKLIST_TOGGLE
  description String

  taskId String
  task   KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

// --- ATS: Recruitment Hub ---

model Job {
  id              String        @id @default(cuid())
  title           String
  description     String        @db.Text
  department      String?
  location        String?
  type            String        @default("FULL_TIME")
  salaryRange     String?
  status          JobStatus     @default(DRAFT)
  requirements    String[]      @default([])
  benefits        String[]      @default([])
  workspaceId     String
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model Candidate {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  phone           String?
  location        String?
  resumeUrl       String?
  avatarUrl       String?
  summary         String?       @db.Text
  skills          String[]      @default([])
  
  // AI Parsing Results
  aiSummary       String?       @db.Text
  aiMatchScore    Int?
  parsedData      Json?
  
  applications    Application[]
  scorecards      Scorecard[]
  notes           AtsNote[]
  
  workspaceId     String
  userId          String
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
  @@index([email])
}

model Application {
  id              String        @id @default(cuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  stage           String        @default("APPLIED")
  status          String        @default("ACTIVE")
  
  source          String?
  referredById    String?
  
  scorecards      Scorecard[]
  interviews      Interview[]
  notes           AtsNote[]
  offers          Offer[]
  
  workspaceId     String
  
  appliedAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([jobId])
  @@index([candidateId])
  @@index([stage])
  @@index([workspaceId])
}

model Interview {
  id              String        @id @default(cuid())
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  title           String
  startTime       DateTime
  endTime         DateTime
  location        String?
  
  status          InterviewStatus @default(SCHEDULED)
  feedback        String?       @db.Text
  
  interviewers    String[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([applicationId])
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Scorecard {
  id              String        @id @default(cuid())
  applicationId   String?
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  candidateId     String
  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  interviewerId   String
  interviewer     User          @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  
  stage           String?
  score           Float?        @default(0)
  feedback        String?       @db.Text
  recommendation  String?
  attributes      Json?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([applicationId])
  @@index([candidateId])
  @@index([interviewerId])
}

model AtsNote {
  id              String        @id @default(cuid())
  applicationId   String?
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  candidateId     String
  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String        @db.Text
  isPrivate       Boolean       @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([applicationId])
  @@index([candidateId])
  @@index([userId])
}

model Offer {
  id              String        @id @default(cuid())
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  salary          String?
  startDate       DateTime?
  status          OfferStatus   @default(DRAFT)
  offerLetterUrl  String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([applicationId])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
