generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String              @id @default(cuid())
  uuid                      String?
  displayName               String?
  username                  String?             @unique
  email                     String?             @unique
  phone                     String?             @unique
  avatar                    String?
  isVerified                Boolean             @default(false)
  isActive                  Boolean             @default(false)
  password                  String?
  uid                       String?
  provider                  String?
  role                      ROLE                @default(GUEST)
  webDeviceToken            String?
  deviceToken               String?
  expoPushToken             String?
  refreshToken              String?
  accessToken               String?
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  lastActive                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  atsNotes                  AtsNote[]
  botFlows                  BotFlow[]
  campaigns                 Campaign[]
  channels                  Channel[]
  contacts                  Contact[]
  contactGroups             ContactGroup[]
  credentials               Credentials[]
  credit                    Credit?
  sharedDocuments           DocumentAccess[]    @relation("UserToDocumentAccess")
  jobs                      Job[]
  kanbanActivities          KanbanActivity[]
  assignedTasks             KanbanTask[]        @relation("TaskAssignee")
  members                   Member[]
  messageTemplates          MessageTemplate[]
  profile                   Profile?
  scorecards                Scorecard[]
  servers                   Server[]
  setting                   Setting?
  whatsAppAuths             WhatsAppAuth[]
  waMessages                WhatsAppMessage[]
  workspaceDocuments        WorkspaceDocument[]
  roles                     Role[]              @relation("RoleToUser")
  workflows                 Workflow[]

  @@index([email])
  @@index([phone])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  general       Json?
  hospitalInfo  Json?
  locale        Json?
  social        Json?
  technical     Json?
  appointments  Json?
  consultation  Json?
  billing       Json?
  departments   Json?
  integrations  Json?
  inventory     Json?
  invoice       Json?
  notifications Json?
  patients      Json?
  pharmacy      Json?
  prescription  Json?
  security      Json?
  services      Json?
  staff         Json?
  privacy       String?
  terms         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Server {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]
  members     Member[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  type      ChannelType @default(TEXT)
  userId    String
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([serverId])
}

model Member {
  id                     String          @id @default(cuid())
  role                   MemberRole      @default(PATIENT)
  userId                 String
  serverId               String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  conversationsInitiated Conversation[]  @relation("MemberOne")
  conversationsReceived  Conversation[]  @relation("MemberTwo")
  directMessages         DirectMessage[]
  server                 Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               Message[]

  @@index([userId])
  @@index([serverId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  fileUrl    String?
  memberId   String
  channelId  String
  deleted    Boolean  @default(false)
  sent       Boolean  @default(false)
  deleivered Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([memberId])
}

model Conversation {
  id             String          @id @default(cuid())
  memberOneId    String
  memberTwoId    String
  memberOne      Member          @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: Cascade)
  memberTwo      Member          @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: Cascade)
  directMessages DirectMessage[]

  @@unique([memberOneId, memberTwoId])
  @@index([memberTwoId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  content        String
  fileUrl        String?
  memberId       String
  conversationId String
  deleted        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([conversationId])
}

model Role {
  id          String       @id @default(cuid())
  title       String       @unique
  description String?
  color       String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")
}

model Permission {
  id          String   @id @default(cuid())
  title       String
  value       String   @unique
  color       String?  @default("#FFFF")
  description String
  category    String?
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String?
  action      String?
  entityId    String?
  entityType  String?
  entityTitle String?
  userId      String?
  userImage   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique
  type      String   @default("virtual")
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String              @id @default(cuid())
  name            String
  description     String?
  status          String              @default("DRAFT")
  messageType     String              @default("text")
  messageTemplate Json
  templateId      String?
  scheduledAt     DateTime?
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  template        MessageTemplate?    @relation(fields: [templateId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]

  @@index([templateId])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  phone      String
  status     String    @default("PENDING")
  errorLog   String?
  variables  Json?
  sentAt     DateTime?
  campaignId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model WhatsAppAuth {
  id              String                  @id @default(cuid())
  userId          String?
  status          WA_STATUS               @default(DISCONNECTED)
  sessionId       String                  @unique
  sessionName     String?
  deviceId        String?
  phoneNumber     String?
  deviceName      String?
  platform        String?
  qrCode          String?
  qrExpiresAt     DateTime?
  credentials     Json?
  connectedAt     DateTime?
  lastConnectedAt DateTime?
  disconnectedAt  DateTime?
  expiresAt       DateTime?
  isActive        Boolean                 @default(true)
  metadata        Json?
  updatedAt       DateTime                @updatedAt
  createdAt       DateTime                @default(now())
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            WhatsAppConnectionLog[]
  keys            WhatsAppSessionKey[]

  @@index([userId])
  @@index([phoneNumber])
}

model MessageTemplate {
  id        String     @id @default(cuid())
  userId    String
  name      String
  category  String     @default("UTILITY")
  language  String     @default("en_US")
  type      String     @default("TEXT")
  body      String
  footer    String?
  buttons   Json?
  metadata  Json?
  status    String     @default("DRAFT")
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  waId      String?  @unique
  userId    String
  jid       String
  text      String
  fromMe    Boolean
  timestamp BigInt
  status    String   @default("SENT")
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jid])
  @@index([createdAt])
}

model WhatsAppConnectionLog {
  id             String        @id @default(cuid())
  whatsappAuthId String?
  event          String
  previousStatus String?
  newStatus      String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  whatsappAuth   WhatsAppAuth? @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)

  @@index([whatsappAuthId])
  @@index([createdAt])
}

model Contact {
  id              String         @id @default(cuid())
  userId          String
  name            String
  phone           String         @unique
  email           String?
  info            Json?
  tags            String[]       @default([])
  lastMessage     String?
  lastInteraction DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups          ContactGroup[] @relation("ContactToGroup")

  @@index([userId])
  @@index([phone])
}

model BotFlow {
  id          String        @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps       BotFlowStep[]

  @@index([userId])
}

model BotFlowStep {
  id        String   @id @default(cuid())
  botFlowId String
  type      String
  config    Json
  positionX Int
  positionY Int
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  botFlow   BotFlow  @relation(fields: [botFlowId], references: [id], onDelete: Cascade)

  @@index([botFlowId])
}

model WhatsAppSessionKey {
  id             String       @id @default(cuid())
  whatsappAuthId String
  keyId          String
  data           String
  whatsappAuth   WhatsAppAuth @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)

  @@unique([whatsappAuthId, keyId])
  @@index([whatsappAuthId])
}

model ContactGroup {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[] @relation("ContactToGroup")

  @@unique([userId, name])
  @@index([userId])
}

model WorkspaceDocument {
  id          String              @id @default(cuid())
  name        String
  description String?
  fileUrl     String?
  fileKey     String?
  fileType    String?
  extension   String?
  fileSize    Int?
  category    String?             @default("GENERAL")
  isFolder    Boolean             @default(false)
  parentId    String?
  workspaceId String
  userId      String
  members     String[]            @default([])
  isStarred   Boolean             @default(false)
  status      String              @default("APPROVED")
  tags        String[]            @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  sharedWith  DocumentAccess[]
  parent      WorkspaceDocument?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    WorkspaceDocument[] @relation("FolderHierarchy")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([parentId])
}

model DocumentAccess {
  id         String            @id @default(cuid())
  documentId String
  userId     String
  role       String            @default("VIEWER")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  document   WorkspaceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation("UserToDocumentAccess", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String
  description String?
  color       String?    @default("#3b82f6")
  type        String     @default("GENERAL")
  parentId    String?
  workspaceId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  posts       Post[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([parentId])
}

model Credentials {
  id          String   @id @default(cuid())
  platform    String
  profile     String?
  credentials Json?
  avatar      String?
  userInfo    Json?
  userId      String
  expired     Boolean  @default(false)
  status      String   @default("disconnected")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id          String     @id @default(cuid())
  title       String?
  content     String
  mediaUrls   String[]   @default([])
  scheduledAt DateTime?
  publishedAt DateTime?
  status      PostStatus @default(DRAFT)
  errorLog    String?
  categoryId  String?
  tags        String[]   @default([])
  workspaceId String
  userId      String
  externalIds Json?
  platforms   String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  category    Category?  @relation(fields: [categoryId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model SystemLog {
  id          String   @id @default(cuid())
  workspaceId String?
  level       String?
  type        String?
  message     String?
  details     Json?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([level])
  @@index([createdAt])
}

model KanbanColumn {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  workspaceId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       KanbanTask[]

  @@index([workspaceId])
}

model KanbanTask {
  id          String            @id @default(cuid())
  title       String
  type        String            @default("task")
  content     String?
  priority    String            @default("medium")
  dueDate     DateTime?
  order       Int               @default(0)
  columnId    String
  workspaceId String
  userId      String
  assigneeId  String?
  coverUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activities  KanbanActivity[]
  checklists  KanbanChecklist[]
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  column      KanbanColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@index([workspaceId])
  @@index([userId])
  @@index([assigneeId])
}

model KanbanChecklist {
  id        String     @id @default(cuid())
  title     String
  completed Boolean    @default(false)
  order     Int        @default(0)
  taskId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model KanbanActivity {
  id          String     @id @default(cuid())
  type        String
  description String
  taskId      String
  userId      String
  createdAt   DateTime   @default(now())
  task        KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  department   String?
  location     String?
  type         String        @default("FULL_TIME")
  salaryRange  String?
  status       JobStatus     @default(DRAFT)
  requirements String[]      @default([])
  benefits     String[]      @default([])
  workspaceId  String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
}

model Candidate {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  location     String?
  resumeUrl    String?
  avatarUrl    String?
  summary      String?
  skills       String[]      @default([])
  aiSummary    String?
  aiMatchScore Int?
  parsedData   Json?
  workspaceId  String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  notes        AtsNote[]
  scorecards   Scorecard[]

  @@index([workspaceId])
  @@index([email])
}

model Application {
  id           String      @id @default(cuid())
  jobId        String
  candidateId  String
  stage        String      @default("APPLIED")
  status       String      @default("ACTIVE")
  source       String?
  referredById String?
  workspaceId  String
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notes        AtsNote[]
  interviews   Interview[]
  offers       Offer[]
  scorecards   Scorecard[]

  @@index([jobId])
  @@index([candidateId])
  @@index([stage])
  @@index([workspaceId])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  title         String
  startTime     DateTime
  endTime       DateTime
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  interviewers  String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Scorecard {
  id             String       @id @default(cuid())
  applicationId  String?
  candidateId    String
  interviewerId  String
  stage          String?
  score          Float?       @default(0)
  feedback       String?
  recommendation String?
  attributes     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer    User         @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([interviewerId])
}

model AtsNote {
  id            String       @id @default(cuid())
  applicationId String?
  candidateId   String
  userId        String
  text          String
  isPrivate     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([userId])
}

model Offer {
  id             String      @id @default(cuid())
  applicationId  String
  salary         String?
  startDate      DateTime?
  status         OfferStatus @default(DRAFT)
  offerLetterUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

enum ROLE {
  ADMIN
  SUPERADMIN
  SERVICE
  GUEST
}

enum ChannelType {
  TEXT
  AUDIO
  VIDEO
}

enum MemberRole {
  DOCTOR
  PATIENT
  ADMIN
  STAFF
}

enum WA_STATUS {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  AUTHENTICATED
  CONNECTED
  LOGGED_OUT
  ERROR
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Workflow {
  id          String              @id @default(cuid())
  name        String
  description String?
  status      String              @default("DRAFT") // DRAFT, ACTIVE
  nodes       Json                @default("[]")
  edges       Json                @default("[]")
  workspaceId String
  userId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  memories    WorkflowMemory[]

  @@index([workspaceId])
  @@index([userId])
}

model WorkflowExecution {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("RUNNING") // RUNNING, SUCCESS, FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  nodes       Json      @default("[]")
  edges       Json      @default("[]")
  logs        Json      @default("[]")
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
}

model WorkflowMemory {
  id          String    @id @default(cuid())
  workflowId  String
  sessionId   String    // Unique key for the conversation context (e.g., chat_123)
  messages    Json      @default("[]") // Stores message history [{role, text}]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sessionId])
  @@index([workflowId])
}
