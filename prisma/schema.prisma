generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                   @id @default(cuid())
  uuid                      String?
  displayName               String?
  username                  String?                  @unique
  email                     String?                  @unique
  phone                     String?                  @unique
  avatar                    String?
  isVerified                Boolean                  @default(false)
  isActive                  Boolean                  @default(false)
  password                  String?
  uid                       String?
  provider                  String?
  role                      ROLE                     @default(GUEST)
  webDeviceToken            String?
  deviceToken               String?
  expoPushToken             String?
  refreshToken              String?
  accessToken               String?
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  lastActive                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  atsNotes                  AtsNote[]
  botFlows                  BotFlow[]
  campaigns                 Campaign[]
  channels                  Channel[]
  contacts                  Contact[]
  contactGroups             ContactGroup[]
  credentials               Credentials[]
  credit                    Credit?
  sharedDocuments           DocumentAccess[]         @relation("UserToDocumentAccess")
  jobs                      Job[]
  kanbanActivities          KanbanActivity[]
  assignedTasks             KanbanTask[]             @relation("TaskAssignee")
  members                   Member[]
  messageTemplates          MessageTemplate[]
  profile                   Profile?
  scorecards                Scorecard[]
  servers                   Server[]
  setting                   Setting?
  systemCrons               SystemCron[]
  whatsAppAuths             WhatsAppAuth[]
  waMessages                WhatsAppMessage[]
  workflows                 Workflow[]
  workspaceDocuments        WorkspaceDocument[]
  roles                     Role[]                   @relation("RoleToUser")
  ecommerceStores           ECommerceStore[]
  ecommerceOrders           ECommerceOrder[]
  ecommerceProducts         ECommerceProduct[]
  ecommerceAbandonedCarts   ECommerceAbandonedCart[]
  waJobs                    WhatsAppJob[]
  waDeliveryLogs            WhatsAppDeliveryLog[]
  agentModels               AgentModel[]
  aiAgents                  AIAgent[]

  @@index([email])
  @@index([phone])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  general       Json?
  hospitalInfo  Json?
  locale        Json?
  social        Json?
  notifications Json?
  security      Json?
  integrations  Json?
  technical     Json?
  services      Json?
  staff         Json?
  privacy       Json?
  terms         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Server {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]
  members     Member[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  type      ChannelType @default(TEXT)
  userId    String
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([serverId])
}

model Member {
  id                     String          @id @default(cuid())
  role                   MemberRole      @default(PATIENT)
  userId                 String
  serverId               String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  conversationsInitiated Conversation[]  @relation("MemberOne")
  conversationsReceived  Conversation[]  @relation("MemberTwo")
  directMessages         DirectMessage[]
  server                 Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               Message[]

  @@index([userId])
  @@index([serverId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  fileUrl    String?
  memberId   String
  channelId  String
  deleted    Boolean  @default(false)
  sent       Boolean  @default(false)
  deleivered Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([memberId])
}

model Conversation {
  id             String          @id @default(cuid())
  memberOneId    String
  memberTwoId    String
  memberOne      Member          @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: Cascade)
  memberTwo      Member          @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: Cascade)
  directMessages DirectMessage[]

  @@unique([memberOneId, memberTwoId])
  @@index([memberTwoId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  content        String
  fileUrl        String?
  memberId       String
  conversationId String
  deleted        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([conversationId])
}

model Role {
  id          String       @id @default(cuid())
  title       String       @unique
  description String?
  color       String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")

  // Inheritance
  parentId    String?
  parent      Role?        @relation("RoleInheritance", fields: [parentId], references: [id])
  children    Role[]       @relation("RoleInheritance")
}

model Permission {
  id          String   @id @default(cuid())
  title       String
  value       String   @unique
  color       String?  @default("#FFFF")
  description String
  category    String?
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String?
  action      String?
  entityId    String?
  entityType  String?
  entityTitle String?
  userId      String?
  userImage   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique
  type      String   @default("virtual")
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String              @id @default(cuid())
  name            String
  description     String?
  status          String              @default("DRAFT")
  messageType     String              @default("text")
  messageTemplate Json
  templateId      String?
  scheduledAt     DateTime?
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  template        MessageTemplate?    @relation(fields: [templateId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]

  @@index([templateId])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  phone      String
  status     String    @default("PENDING")
  errorLog   String?
  variables  Json?
  sentAt     DateTime?
  campaignId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model WhatsAppAuth {
  id              String                  @id @default(cuid())
  userId          String?
  status          WA_STATUS               @default(DISCONNECTED)
  sessionId       String                  @unique
  sessionName     String?
  deviceId        String?
  phoneNumber     String?
  deviceName      String?
  platform        String?
  qrCode          String?
  qrExpiresAt     DateTime?
  credentials     Json?
  connectedAt     DateTime?
  lastConnectedAt DateTime?
  disconnectedAt  DateTime?
  expiresAt       DateTime?
  isActive        Boolean                 @default(true)
  metadata        Json?
  updatedAt       DateTime                @updatedAt
  createdAt       DateTime                @default(now())
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            WhatsAppConnectionLog[]
  keys            WhatsAppSessionKey[]

  @@index([userId])
  @@index([phoneNumber])
}

model MessageTemplate {
  id           String     @id @default(cuid())
  templateId   String?
  userId       String
  name         String
  templateName String?
  approved     Boolean    @default(false)
  category     String     @default("UTILITY")
  language     String     @default("en_US")
  type         String     @default("TEXT")
  body         String
  footer       String?
  buttons      Json?
  metadata     Json?
  status       String     @default("DRAFT")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isDefault    Boolean    @default(false)
  platform     String     @default("WHATSAPP_CLOUD")
  campaigns    Campaign[]
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  waId      String?  @unique
  userId    String
  jid       String
  text      String
  fromMe    Boolean
  timestamp BigInt
  status    String   @default("SENT")
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jid])
  @@index([createdAt])
}

model WhatsAppConnectionLog {
  id             String        @id @default(cuid())
  whatsappAuthId String?
  event          String
  previousStatus String?
  newStatus      String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  whatsappAuth   WhatsAppAuth? @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)

  @@index([whatsappAuthId])
  @@index([createdAt])
}

model Contact {
  id              String           @id @default(cuid())
  workspaceId     String?          @default("cmnbhifag000458ikwhv1zso2")
  userId          String
  name            String
  phone           String
  email           String?
  type            String?          @default("CONTACT") // CONTACT, CLIENT, LEAD
  platform        String?          @default("WHATSAPP")
  info            Json?
  tags            String[]         @default([])
  whatsappName    String?
  lastMessage     String?
  lastInteraction DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups          ContactGroup[]   @relation("ContactToGroup")
  ecommerceOrders ECommerceOrder[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      String?
  subscribed      Boolean          @default(true)

  @@unique([workspaceId, phone])
  @@index([userId])
  @@index([workspaceId])
  @@index([phone])
}

model BotFlow {
  id          String        @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  active      Boolean       @default(true)
  nodes       Json          @default("[]")
  edges       Json          @default("[]")
  steps       BotFlowStep[]

  @@index([userId])
}

model BotFlowStep {
  id        String   @id @default(cuid())
  botFlowId String
  type      String
  config    Json
  positionX Int
  positionY Int
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  botFlow   BotFlow  @relation(fields: [botFlowId], references: [id], onDelete: Cascade)

  @@index([botFlowId])
}

model WhatsAppSessionKey {
  id             String       @id @default(cuid())
  whatsappAuthId String
  keyId          String
  data           String
  whatsappAuth   WhatsAppAuth @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)

  @@unique([whatsappAuthId, keyId])
  @@index([whatsappAuthId])
}

model WhatsAppJob {
  id          String                @id @default(cuid())
  userId      String
  type        String                @default("CAMPAIGN") // CAMPAIGN, TRANSACTIONAL, AUTOMATION
  status      String                @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PAUSED
  payload     Json
  priority    Int                   @default(0)
  retryCount  Int                   @default(0)
  maxRetries  Int                   @default(3)
  errorLog    String?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  logs        WhatsAppDeliveryLog[]
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model WhatsAppDeliveryLog {
  id          String       @id @default(cuid())
  jobId       String?
  userId      String
  jid         String
  waId        String?      @unique
  status      String       @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED
  error       String?
  metadata    Json?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  job         WhatsAppJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
  @@index([jid])
  @@index([status])
}

model ContactGroup {
  id          String    @id @default(cuid())
  workspaceId String?   @default("cmnbhifag000458ikwhv1zso2")
  userId      String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[] @relation("ContactToGroup")

  @@unique([workspaceId, name])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceDocument {
  id          String              @id @default(cuid())
  name        String
  description String?
  fileUrl     String?
  fileKey     String?
  fileType    String?
  extension   String?
  fileSize    Int?
  category    String?             @default("GENERAL")
  content     String?             @db.Text
  isFolder    Boolean             @default(false)
  parentId    String?
  workspaceId String
  userId      String
  members     String[]            @default([])
  isStarred   Boolean             @default(false)
  status      String              @default("APPROVED")
  tags        String[]            @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  sharedWith  DocumentAccess[]
  parent      WorkspaceDocument?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    WorkspaceDocument[] @relation("FolderHierarchy")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([parentId])
}

model DocumentAccess {
  id         String            @id @default(cuid())
  documentId String
  userId     String
  role       String            @default("VIEWER")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  document   WorkspaceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation("UserToDocumentAccess", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String
  description String?
  color       String?    @default("#3b82f6")
  type        String     @default("GENERAL")
  parentId    String?
  workspaceId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  posts       Post[]
  jobs        Job[]
  contacts    Contact[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([parentId])
}

model Credentials {
  id          String    @id @default(cuid())
  platform    String
  profile     String?
  type        String?
  credentials Json?
  userId      String
  workspaceId String?
  expired     Boolean   @default(false)
  status      String    @default("disconnected")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  avatar      String?
  userInfo    Json?
  expiresAt   DateTime?
  environment String    @default("PROD")
  isDefault   Boolean   @default(false)
  verified    Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, isDefault])
}

model Post {
  id          String     @id @default(cuid())
  title       String?
  content     String
  mediaUrls   String[]   @default([])
  scheduledAt DateTime?
  publishedAt DateTime?
  status      PostStatus @default(DRAFT)
  errorLog    String?
  categoryId  String?
  tags        String[]   @default([])
  workspaceId String
  userId      String
  externalIds Json?
  platforms   String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  category    Category?  @relation(fields: [categoryId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model SystemLog {
  id          String   @id @default(cuid())
  workspaceId String?
  level       String?
  type        String?
  message     String?
  details     Json?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([level])
  @@index([createdAt])
}

model KanbanColumn {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  workspaceId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       KanbanTask[]

  @@index([workspaceId])
}

model KanbanTask {
  id          String            @id @default(cuid())
  title       String
  type        String            @default("task")
  content     String?
  priority    String            @default("medium")
  dueDate     DateTime?
  order       Int               @default(0)
  columnId    String
  workspaceId String
  userId      String
  assigneeId  String?
  coverUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activities  KanbanActivity[]
  checklists  KanbanChecklist[]
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  column      KanbanColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@index([workspaceId])
  @@index([userId])
  @@index([assigneeId])
}

model KanbanChecklist {
  id        String     @id @default(cuid())
  title     String
  completed Boolean    @default(false)
  order     Int        @default(0)
  taskId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model KanbanActivity {
  id          String     @id @default(cuid())
  type        String
  description String
  taskId      String
  userId      String
  createdAt   DateTime   @default(now())
  task        KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  department   String?
  location     String?
  type         String        @default("FULL_TIME")
  salaryRange  String?
  status       JobStatus     @default(DRAFT)
  requirements String[]      @default([])
  benefits     String[]      @default([])
  workspaceId  String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?

  @@index([workspaceId])
  @@index([status])
  @@index([categoryId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Candidate {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  location     String?
  resumeUrl    String?
  avatarUrl    String?
  summary      String?
  skills       String[]      @default([])
  aiSummary    String?
  aiMatchScore Int?
  parsedData   Json?
  workspaceId  String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  notes        AtsNote[]
  scorecards   Scorecard[]

  @@index([workspaceId])
  @@index([email])
}

model Application {
  id           String      @id @default(cuid())
  jobId        String
  candidateId  String
  stage        String      @default("APPLIED")
  status       String      @default("ACTIVE")
  source       String?
  referredById String?
  workspaceId  String
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notes        AtsNote[]
  interviews   Interview[]
  offers       Offer[]
  scorecards   Scorecard[]

  @@index([jobId])
  @@index([candidateId])
  @@index([stage])
  @@index([workspaceId])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  title         String
  startTime     DateTime
  endTime       DateTime
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  interviewers  String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Scorecard {
  id             String       @id @default(cuid())
  applicationId  String?
  candidateId    String
  interviewerId  String
  stage          String?
  score          Float?       @default(0)
  feedback       String?
  recommendation String?
  attributes     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer    User         @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([interviewerId])
}

model AtsNote {
  id            String       @id @default(cuid())
  applicationId String?
  candidateId   String
  userId        String
  text          String
  isPrivate     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([userId])
}

model Offer {
  id             String      @id @default(cuid())
  applicationId  String
  salary         String?
  startDate      DateTime?
  status         OfferStatus @default(DRAFT)
  offerLetterUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Workflow {
  id          String              @id @default(cuid())
  name        String
  description String?
  nodes       Json                @default("[]")
  edges       Json                @default("[]")
  workspaceId String
  userId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  definition  Json?
  status      WorkflowStatus      @default(DRAFT)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  memories    WorkflowMemory[]

  @@index([workspaceId])
  @@index([userId])
}

model WorkflowExecution {
  id         String    @id @default(cuid())
  workflowId String
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  logs       Json      @default("[]")
  edges      Json      @default("[]")
  nodes      Json      @default("[]")
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
}

model WorkflowMemory {
  id         String   @id @default(cuid())
  workflowId String
  sessionId  String
  messages   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sessionId])
  @@index([workflowId])
}

model SystemCron {
  id             String           @id @default(cuid())
  name           String
  description    String?
  cronExpression String
  status         SystemCronStatus @default(ACTIVE)
  targetType     String           @default("FLOWBOT")
  targetId       String?
  payload        Json?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  workspaceId    String
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([nextRunAt])
}

enum ROLE {
  ADMIN
  SUPERADMIN
  SERVICE
  GUEST
}

enum ChannelType {
  TEXT
  AUDIO
  VIDEO
}

enum MemberRole {
  DOCTOR
  PATIENT
  ADMIN
  STAFF
}

enum WA_STATUS {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  AUTHENTICATED
  CONNECTED
  LOGGED_OUT
  ERROR
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
}

enum SystemCronStatus {
  ACTIVE
  INACTIVE
  ERROR
  COMPLETED
}

model ECommerceStore {
  id             String                   @id @default(cuid())
  userId         String
  platform       String                   @default("shopify") // shopify | woocommerce
  name           String
  storeUrl       String
  accessToken    String?
  apiKey         String?
  apiSecret      String?
  webhookSecret  String?
  status         String                   @default("connected")
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         ECommerceOrder[]
  products       ECommerceProduct[]
  abandonedCarts ECommerceAbandonedCart[]

  @@index([userId])
}

model ECommerceOrder {
  id                String         @id @default(cuid())
  storeId           String
  externalOrderId   String         @unique // Platform's Order ID
  orderNumber       String?
  totalAmount       Float
  currency          String         @default("INR")
  status            String
  financialStatus   String?
  fulfillmentStatus String?
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  contactId         String? // Link to internal Contact if exists
  metadata          Json?
  userId            String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  store             ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact           Contact?       @relation(fields: [contactId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@index([externalOrderId])
}

model ECommerceProduct {
  id                String         @id @default(cuid())
  storeId           String
  externalProductId String         @unique
  title             String
  description       String?
  price             Float
  currency          String         @default("INR")
  imageUrl          String?
  status            String
  inventoryCount    Int?
  metadata          Json?
  userId            String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  store             ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
}

model ECommerceAbandonedCart {
  id             String         @id @default(cuid())
  storeId        String
  externalCartId String         @unique
  checkoutUrl    String?
  totalAmount    Float
  currency       String         @default("INR")
  customerEmail  String?
  customerPhone  String?
  recovered      Boolean        @default(false)
  lastReminderAt DateTime?
  reminderCount  Int            @default(0)
  metadata       Json?
  userId         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
}

model EmailAssignment {
  id           String   @id @default(cuid())
  workspaceId  String
  event        String // e.g., "USER_REGISTRATION", "USER_INVITATION"
  templateName String // e.g., "RegistrationMail.jsx"
  subject      String?
  fromEmail    String?
  isActive     Boolean  @default(true)
  content      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, event])
  @@index([workspaceId])
}

model AgentModel {
  id           String   @id @default(cuid())
  workspaceId  String
  provider     String
  name         String
  apiKey       String
  description  String?
  healthStatus String   @default("UNTESTED")
  latency      String?
  successRate  String?
  capability   String?
  bestFor      String?
  baseUrl      String?
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  AgentModelAssignment[]

  @@index([workspaceId])
  @@index([userId])
}

model AIAgent {
  id           String      @id @default(cuid())
  workspaceId  String
  name         String
  role         String?
  type         String      @default("OpenClaw")
  status       String      @default("offline")
  description  String?
  isMain       Boolean     @default(false)
  
  // Hierarchy: Master -> Sub relationship
  parentId     String?
  parent       AIAgent?    @relation("AgentHierarchy", fields: [parentId], references: [id])
  subAgents    AIAgent[]   @relation("AgentHierarchy")
  
  // Model Fallback Logic
  strategy     String      @default("SEQUENTIAL") // SEQUENTIAL, PARALLEL
  models       AgentModelAssignment[]
  
  config       Json? // Additional task-specific configuration
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model AgentModelAssignment {
  id           String      @id @default(cuid())
  agentId      String
  modelId      String
  priority     Int         @default(0) // 0 = Primary, 1+ = Fallbacks
  agent        AIAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  model        AgentModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([agentId, modelId])
  @@index([agentId])
  @@index([modelId])
}
