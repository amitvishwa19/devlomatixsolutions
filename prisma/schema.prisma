generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppSettings {
  id            String   @id @default(uuid())
  key           String   @unique
  general       Json?
  hospitalInfo  Json?
  locale        Json?
  social        Json?
  technical     Json?
  appointments  Json?
  consultation  Json?
  billing       Json?
  departments   Json?
  integrations  Json?
  inventory     Json?
  invoice       Json?
  notifications Json?
  patients      Json?
  pharmacy      Json?
  prescription  Json?
  security      Json?
  services      Json?
  staff         Json?
  privacy       String?
  terms         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Appointment {
  id                               String            @id @default(uuid())
  patientId                        String
  doctorId                         String
  uid                              String?
  date                             String
  slot                             Json?
  time                             String?
  note                             String?
  additionalNote                   String?
  doctorNote                       String?
  mode                             Json?
  visitType                        String?           @default("consultation")
  status                           APPOINTMENTSTATUS @default(SCHEDULED)
  type                             APPIONTMENTTYPE   @default(OPD)
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt
  User_Appointment_doctorIdToUser  User              @relation("Appointment_doctorIdToUser", fields: [doctorId], references: [id], onDelete: Cascade)
  User_Appointment_patientIdToUser User              @relation("Appointment_patientIdToUser", fields: [patientId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String?
  action      String?
  entityId    String?
  entityType  String?
  entityTitle String?
  userId      String?
  userImage   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id             String     @id @default(uuid())
  name           String
  slug           String
  description    String?
  icon           String?    @default("folder")
  color          String?
  parentId       String?
  level          Int        @default(0)
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Tag            Tag[]

  @@index([parentId])
}

model Channel {
  id        String      @id @default(uuid())
  name      String
  type      ChannelType @default(TEXT)
  userId    String
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Message   Message[]

  @@index([serverId])
}

model Conversation {
  id                                      String          @id
  memberOneId                             String
  memberTwoId                             String
  Member_Conversation_memberOneIdToMember Member          @relation("Conversation_memberOneIdToMember", fields: [memberOneId], references: [id], onDelete: Cascade)
  Member_Conversation_memberTwoIdToMember Member          @relation("Conversation_memberTwoIdToMember", fields: [memberTwoId], references: [id], onDelete: Cascade)
  DirectMessage                           DirectMessage[]

  @@unique([memberOneId, memberTwoId])
  @@index([memberTwoId])
}

model Credit {
  id        String   @id @default(uuid())
  userId    String   @unique
  type      String   @default("virtual")
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id           String    @id @default(uuid())
  name         String
  value        String    @unique
  code         String?
  category     String
  image        String
  icon         String
  color        String?
  description  String?
  headDoctorId String?
  floorNumber  Int?
  roomCount    Int?      @default(0)
  bedCount     Int?      @default(0)
  isActive     Boolean   @default(true)
  hospitalId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  User         User[]
}

model DirectMessage {
  id             String       @id @default(uuid())
  content        String
  fileUrl        String?
  memberId       String
  conversationId String
  deleted        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([memberId])
}

model Hospital {
  id             String       @id @default(uuid())
  key            String       @unique
  name           String
  code           String       @unique
  address        Json?
  phone          String?
  email          String?
  registrationNo String?
  licenceNo      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Department     Department[]
  User           User[]
}

model Member {
  id                                            String          @id @default(uuid())
  role                                          MemberRole      @default(PATIENT)
  userId                                        String
  serverId                                      String
  createdAt                                     DateTime        @default(now())
  updatedAt                                     DateTime        @updatedAt
  Conversation_Conversation_memberOneIdToMember Conversation[]  @relation("Conversation_memberOneIdToMember")
  Conversation_Conversation_memberTwoIdToMember Conversation[]  @relation("Conversation_memberTwoIdToMember")
  DirectMessage                                 DirectMessage[]
  Server                                        Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  User                                          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  Message                                       Message[]

  @@index([serverId])
  @@index([userId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  fileUrl    String?
  memberId   String
  channelId  String
  deleted    Boolean  @default(false)
  sent       Boolean  @default(false)
  deleivered Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  Member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([memberId])
}

model Permission {
  id          String   @id @default(uuid())
  title       String
  value       String   @unique
  color       String?  @default("#FFFF")
  description String
  category    String?
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Role        Role[]
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String       @id @default(uuid())
  title       String       @unique
  description String?
  color       String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
  users       User[]
}

model Server {
  id          String    @id @default(uuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Channel     Channel[]
  Member      Member[]
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(uuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  color       String     @default("#FFFF")
  status      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Category    Category[]

  @@index([slug])
}

model User {
  id                                      String        @id @default(uuid())
  uuid                                    String?
  displayName                             String?
  username                                String?       @unique
  email                                   String?       @unique
  phone                                   String?       @unique
  avatar                                  String?
  isVerified                              Boolean       @default(false)
  isActive                                Boolean       @default(false)
  password                                String?
  uid                                     String?
  provider                                String?
  departmentId                            String?
  hospitalId                              String?
  role                                    ROLE          @default(GUEST)
  webDeviceToken                          String?
  deviceToken                             String?
  expoPushToken                           String?
  refreshToken                            String?
  accessToken                             String?
  forgotPasswordToken                     String?
  forgotPasswordTokenExpiry               DateTime?
  verifyToken                             String?
  verifyTokenExpiry                       DateTime?
  lastActive                              DateTime?
  createdAt                               DateTime      @default(now())
  updatedAt                               DateTime      @updatedAt
  Appointment_Appointment_doctorIdToUser  Appointment[] @relation("Appointment_doctorIdToUser")
  Appointment_Appointment_patientIdToUser Appointment[] @relation("Appointment_patientIdToUser")
  channels                                Channel[]
  credit                                  Credit?
  members                                 Member[]
  profile                                 Profile?
  servers                                 Server[]
  setting                                 Setting?
  Department                              Department?   @relation(fields: [departmentId], references: [id])
  Hospital                                Hospital?     @relation(fields: [hospitalId], references: [id])
  roles                                   Role[]

  @@index([email])
  @@index([phone])
}

enum APPIONTMENTTYPE {
  IPD
  OPD
}

enum APPOINTMENTSTATUS {
  SCHEDULED
  CONFIRMED
  INPROGRESS
  COMPLETED
  NOSHOW
  CANCELLED
}

enum ChannelType {
  TEXT
  AUDIO
  VIDEO
}

enum MemberRole {
  DOCTOR
  PATIENT
  ADMIN
  STAFF
  USER
}

enum ROLE {
  ADMIN
  SUPERADMIN
  DOCTOR
  PATIENT
  NURSE
  SERVICE
  GUEST
}
