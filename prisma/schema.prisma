generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String         @id @default(cuid())
  sku                       String?
  uuid                      String?
  displayName               String?
  username                  String?        @unique
  email                     String?        @unique
  phone                     String?        @unique
  avatar                    String?
  isVerified                Boolean        @default(false)
  isActive                  Boolean        @default(false)
  password                  String?
  uid                       String?
  provider                  String?
  departmentId              String?
  hospitalId                String?
  role                      ROLE           @default(GUEST)
  demographic               Json?
  vitals                    Json?
  medicalHistory            Json?
  allergies                 Json?
  insurance                 Json?
  emergencyContact          Json?
  webDeviceToken            String?
  deviceToken               String?
  expoPushToken             String?
  refreshToken              String?
  accessToken               String?
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  lastActive                DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  appointmentsAsDoctor      Appointment[]  @relation("Appointment_doctorIdToUser")
  appointmentsAsPatient     Appointment[]  @relation("Appointment_patientIdToUser")
  prescriptionsAsDoctor     Prescription[] @relation("Prescription_doctorIdToUser")
  prescriptionsAsPatient    Prescription[] @relation("Prescription_patientIdToUser")
  labOrdersAsRequester      LabOrder[]     @relation("LabOrder_requesterIdToUser")
  labOrdersAsPatient        LabOrder[]     @relation("LabOrder_patientIdToUser")
  invoices                  Invoice[]
  admissions                Admission[]
  channels                  Channel[]
  credit                    Credit?
  members                   Member[]
  profile                   Profile?
  servers                   Server[]
  setting                   Setting?
  department                Department?    @relation(fields: [departmentId], references: [id])
  hospital                  Hospital?      @relation(fields: [hospitalId], references: [id])
  roles                     Role[]         @relation("RoleToUser")
  workspaces                Workspace[]

  @@index([email])
  @@index([phone])
}

model Server {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]
  members     Member[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]
  members     Member[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  general       Json?
  hospitalInfo  Json?
  locale        Json?
  social        Json?
  technical     Json?
  appointments  Json?
  consultation  Json?
  billing       Json?
  departments   Json?
  integrations  Json?
  inventory     Json?
  invoice       Json?
  notifications Json?
  patients      Json?
  pharmacy      Json?
  prescription  Json?
  security      Json?
  services      Json?
  staff         Json?
  privacy       String?
  terms         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Appointment {
  id             String            @id @default(cuid())
  serverId       String?
  patientId      String
  doctorId       String
  departmentId   String?
  uid            String?
  date           String
  slot           Json?
  time           String?
  note           String?
  additionalNote String?
  doctorNote     String?
  mode           Json?
  visitType      String?           @default("consultation")
  status         APPOINTMENTSTATUS @default(SCHEDULED)
  type           APPIONTMENTTYPE   @default(OPD)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  doctor         User              @relation("Appointment_doctorIdToUser", fields: [doctorId], references: [id], onDelete: Cascade)
  patient        User              @relation("Appointment_patientIdToUser", fields: [patientId], references: [id], onDelete: Cascade)
  department     Department?       @relation(fields: [departmentId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String?
  action      String?
  entityId    String?
  entityType  String?
  entityTitle String?
  userId      String?
  userImage   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String
  description    String?
  icon           String?    @default("folder")
  color          String?
  parentId       String?
  level          Int        @default(0)
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Tag            Tag[]

  @@index([parentId])
}

model Channel {
  id          String      @id @default(cuid())
  name        String
  type        ChannelType @default(TEXT)
  userId      String
  serverId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  server      Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Message     Message[]
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])
  workspaceId String?

  @@index([serverId])
}

model Conversation {
  id            String          @id
  memberOneId   String
  memberTwoId   String
  memberOne     Member          @relation("Conversation_memberOneIdToMember", fields: [memberOneId], references: [id], onDelete: Cascade)
  memberTwo     Member          @relation("Conversation_memberTwoIdToMember", fields: [memberTwoId], references: [id], onDelete: Cascade)
  DirectMessage DirectMessage[]

  @@unique([memberOneId, memberTwoId])
  @@index([memberTwoId])
}

model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique
  type      String   @default("virtual")
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id           String        @id @default(cuid())
  name         String
  value        String        @unique
  code         String?
  category     String
  image        String
  icon         String
  color        String?
  description  String?
  headDoctorId String?
  floorNumber  Int?
  roomCount    Int?          @default(0)
  bedCount     Int?          @default(0)
  isActive     Boolean       @default(true)
  hospitalId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hospital     Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  users        User[]
  appointments Appointment[]
}

model DirectMessage {
  id             String       @id @default(cuid())
  content        String
  fileUrl        String?
  memberId       String
  conversationId String
  deleted        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([memberId])
}

model Hospital {
  id             String       @id @default(cuid())
  key            String       @unique
  name           String
  code           String       @unique
  address        Json?
  phone          String?
  email          String?
  registrationNo String?
  licenceNo      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  departments    Department[]
  users          User[]
}

model Member {
  id                       String          @id @default(cuid())
  role                     MemberRole      @default(PATIENT)
  userId                   String
  serverId                 String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  conversationsAsMemberOne Conversation[]  @relation("Conversation_memberOneIdToMember")
  conversationsAsMemberTwo Conversation[]  @relation("Conversation_memberTwoIdToMember")
  directMessages           DirectMessage[]
  server                   Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages                 Message[]
  workspace                Workspace?      @relation(fields: [workspaceId], references: [id])
  workspaceId              String?

  @@index([serverId])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  fileUrl    String?
  memberId   String
  channelId  String
  deleted    Boolean  @default(false)
  sent       Boolean  @default(false)
  deleivered Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([memberId])
}

model Permission {
  id          String   @id @default(cuid())
  title       String
  value       String   @unique
  color       String?  @default("#FFFF")
  description String
  category    String?
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model Role {
  id          String       @id @default(cuid())
  title       String       @unique
  description String?
  color       String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")
}

model Tag {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  color       String     @default("#FFFF")
  status      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Category    Category[]

  @@index([slug])
}

enum APPIONTMENTTYPE {
  IPD
  OPD
}

enum APPOINTMENTSTATUS {
  SCHEDULED
  CONFIRMED
  INPROGRESS
  COMPLETED
  NOSHOW
  CANCELLED
}

enum ChannelType {
  TEXT
  AUDIO
  VIDEO
}

enum MemberRole {
  DOCTOR
  PATIENT
  ADMIN
  STAFF
  USER
}

enum ROLE {
  ADMIN
  SUPERADMIN
  DOCTOR
  PATIENT
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  RECEPTIONIST
  SERVICE
  GUEST
}

model Prescription {
  id               String             @id @default(cuid())
  serverId         String?
  patientId        String
  doctorId         String
  appointmentId    String?
  diagnosis        String?
  notes            String?
  status           PRESCRIPTIONSTATUS @default(ACTIVE)
  refillsRemaining Int                @default(0)
  prescribedDate   DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  doctor           User               @relation("Prescription_doctorIdToUser", fields: [doctorId], references: [id], onDelete: Cascade)
  patient          User               @relation("Prescription_patientIdToUser", fields: [patientId], references: [id], onDelete: Cascade)
  items            PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineId     String?
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  route          String?
  instructions   String?
  quantity       Int          @default(1)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id                String         @id @default(cuid())
  serverId          String?
  patientId         String
  requesterId       String
  appointmentId     String?
  priority          LABPRIORITY    @default(ROUTINE)
  status            LABORDERSTATUS @default(ORDERED)
  notes             String?
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  patient           User           @relation("LabOrder_patientIdToUser", fields: [patientId], references: [id], onDelete: Cascade)
  requester         User           @relation("LabOrder_requesterIdToUser", fields: [requesterId], references: [id], onDelete: Cascade)
  results           LabResult[]
}

model LabResult {
  id         String   @id @default(cuid())
  orderId    String
  testName   String
  value      String
  unit       String?
  range      String?
  status     String?
  notes      String?
  recordedAt DateTime @default(now())
  order      LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id           String          @id @default(cuid())
  serverId     String?
  sku          String?         @unique
  name         String
  genericName  String?
  category     String?
  description  String?
  quantity     Int             @default(0)
  reorderLevel Int             @default(10)
  unit         String?
  costPrice    Float?
  sellingPrice Float?
  expiryDate   DateTime?
  batchNumber  String?
  location     String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
}

model StockMovement {
  id          String        @id @default(cuid())
  itemId      String
  type        MOVEMENTTYPE
  quantity    Int
  previousQty Int
  newQty      Int
  reference   String?
  notes       String?
  performedBy String?
  createdAt   DateTime      @default(now())
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Room {
  id           String   @id @default(cuid())
  serverId     String?
  roomNumber   String   @unique
  type         ROOMTYPE @default(GENERAL)
  floor        Int?
  departmentId String?
  beds         Bed[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bed {
  id           String             @id @default(cuid())
  roomId       String
  bedNumber    String
  status       BEDSTATUS          @default(AVAILABLE)
  housekeeping HOUSEKEEPINGSTATUS @default(CLEAN)
  room         Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admissions   Admission[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Admission {
  id           String    @id @default(cuid())
  serverId     String?
  patientId    String
  bedId        String
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?
  status       String    @default("admitted") // admitted, discharged, transferred
  reason       String?
  notes        String?
  patient      User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bed          Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  serverId      String?
  invoiceNumber String        @unique
  patientId     String
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  discount      Float         @default(0)
  total         Float         @default(0)
  amountPaid    Float         @default(0)
  balance       Float         @default(0)
  status        INVOICESTATUS @default(UNPAID)
  dueDate       DateTime?
  patient       User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float
  source      String? // appointment, pharmacy, lab, etc
  sourceId    String?
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Float
  method        String? // cash, card, online
  reference     String?
  transactionId String?
  notes         String?
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum PRESCRIPTIONSTATUS {
  ACTIVE
  ONHOLD
  COMPLETED
  DISCONTINUED
}

enum LABORDERSTATUS {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LABPRIORITY {
  ROUTINE
  URGENT
  STAT
}

enum MOVEMENTTYPE {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum ROOMTYPE {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  EMERGENCY
}

enum BEDSTATUS {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  DISCHARGE_PENDING
}

enum HOUSEKEEPINGSTATUS {
  CLEAN
  NEEDS_CLEANING
  CLEANING_IN_PROGRESS
}

enum INVOICESTATUS {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
  VOID
}
