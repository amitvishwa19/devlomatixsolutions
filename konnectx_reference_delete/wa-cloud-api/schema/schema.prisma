// Prisma schema for the WhatsApp Cloud API module.
// Mirrors the public.* tables in the connected Supabase Postgres database.
// Generated by hand from the live Supabase schema — keep in sync when migrations change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

model wa_phone_numbers {
  id                String   @id @default(uuid()) @db.Uuid
  display_name      String
  phone_number      String
  phone_number_id   String   @unique
  waba_id           String
  status            String   @default("connected")
  verified_name     String?
  quality_rating    String?  @default("unknown")
  is_default        Boolean  @default(false)
  metadata          Json     @default("{}")
  last_verified_at  DateTime? @db.Timestamptz(6)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_account_credentials {
  id                String   @id @default(uuid()) @db.Uuid
  phone_number_id   String   @unique @db.Uuid
  access_token      String
  token_preview     String
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// ---------- Contacts & conversations ----------

model wa_contacts {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  phone_number      String   @unique
  source            String   @default("manual")
  status            String   @default("active")
  tags              String[] @default([])
  custom_fields     Json     @default("{}")
  lifecycle_stage   String?
  notes             String?
  metadata          Json     @default("{}")
  last_message_at   DateTime? @db.Timestamptz(6)
  opted_out_at      DateTime? @db.Timestamptz(6)
  opt_out_reason    String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_conversations {
  id                       String   @id @default(uuid()) @db.Uuid
  contact_id               String?  @db.Uuid
  phone_number_id          String?  @db.Uuid
  external_contact_phone   String
  status                   String   @default("open")
  assigned_to              String?
  labels                   String[] @default([])
  unread_count             Int      @default(0)
  last_message_preview     String?
  last_message_at          DateTime? @db.Timestamptz(6)
  metadata                 Json     @default("{}")
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)

  @@unique([phone_number_id, external_contact_phone])
  @@schema("public")
}

model wa_messages {
  id                   String   @id @default(uuid()) @db.Uuid
  conversation_id      String?  @db.Uuid
  contact_id           String?  @db.Uuid
  phone_number_id      String?  @db.Uuid
  provider_message_id  String?
  direction            String
  message_type         String   @default("text")
  body                 String?
  media_id             String?
  media_url            String?
  media_mime_type      String?
  template_name        String?
  template_language    String?
  status               String   @default("queued")
  error_message        String?
  ai_summary           String?
  sentiment            String?
  raw_payload          Json     @default("{}")
  sent_at              DateTime? @db.Timestamptz(6)
  delivered_at         DateTime? @db.Timestamptz(6)
  read_at              DateTime? @db.Timestamptz(6)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// ---------- Templates & media ----------

model wa_templates {
  id                String   @id @default(uuid()) @db.Uuid
  waba_id           String
  name              String
  language          String
  category          String
  status            String   @default("UNKNOWN")
  components        Json     @default("[]")
  variables         Json     @default("[]")
  rejection_reason  String?
  metadata          Json     @default("{}")
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([waba_id, name, language])
  @@schema("public")
}

model wa_media_assets {
  id                 String   @id @default(uuid()) @db.Uuid
  phone_number_id    String?  @db.Uuid
  filename           String
  media_type         String
  mime_type          String
  source_url         String?
  provider_media_id  String?
  file_size          BigInt?
  usage_count        Int      @default(0)
  metadata           Json     @default("{}")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// ---------- Campaigns ----------

model wa_campaigns {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  phone_number_id    String?  @db.Uuid
  template_id        String?  @db.Uuid
  status             String   @default("draft")
  audience_filter    Json     @default("{}")
  variable_mapping   Json     @default("{}")
  variants           Json     @default("[]")
  pacing_per_minute  Int      @default(20)
  total_count        Int      @default(0)
  sent_count         Int      @default(0)
  delivered_count    Int      @default(0)
  read_count         Int      @default(0)
  failed_count       Int      @default(0)
  metadata           Json     @default("{}")
  scheduled_at       DateTime? @db.Timestamptz(6)
  started_at         DateTime? @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_campaign_recipients {
  id                  String   @id @default(uuid()) @db.Uuid
  campaign_id         String   @db.Uuid
  contact_id          String?  @db.Uuid
  recipient_phone     String
  variables           Json     @default("{}")
  status              String   @default("queued")
  variant             String?
  provider_message_id String?
  error_message       String?
  sent_at             DateTime? @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// ---------- Automation, segments, quick replies ----------

model wa_automation_rules {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  rule_type           String   @default("keyword")
  enabled             Boolean  @default(true)
  priority            Int      @default(100)
  match_keywords      String[] @default([])
  match_mode          String   @default("any")
  case_sensitive      Boolean  @default(false)
  reply_type          String   @default("text")
  reply_body          String?
  template_id         String?  @db.Uuid
  template_language   String?
  cooldown_minutes    Int      @default(0)
  office_hours        Json     @default("{}")
  metadata            Json     @default("{}")
  trigger_count       Int      @default(0)
  last_triggered_at   DateTime? @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_segments {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  filter      Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_quick_replies {
  id         String   @id @default(uuid()) @db.Uuid
  shortcut   String
  body       String
  category   String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_assignees {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  email      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_test_numbers {
  id         String   @id @default(uuid()) @db.Uuid
  label      String
  phone      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// ---------- Logs & webhooks ----------

model wa_send_attempts {
  id                  String   @id @default(uuid()) @db.Uuid
  message_id          String?  @db.Uuid
  phone_number_id     String?  @db.Uuid
  template_id         String?  @db.Uuid
  template_name       String?
  recipient_phone     String?
  kind                String   @default("send_test_template")
  stage               String   @default("send")
  attempt_number      Int      @default(1)
  status              String   @default("pending")
  http_status         Int?
  latency_ms          Int?
  provider_message_id String?
  error_code          String?
  error_message       String?
  request_payload     Json     @default("{}")
  response_payload    Json     @default("{}")
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model wa_webhook_events {
  id                  String   @id @default(uuid()) @db.Uuid
  event_type          String
  provider_object     String?
  provider_message_id String?
  payload             Json     @default("{}")
  processed           Boolean  @default(false)
  processing_error    String?
  received_at         DateTime @default(now()) @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}